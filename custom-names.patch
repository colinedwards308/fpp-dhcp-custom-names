+/** Read persistent labels without changing DHCP or Apache configuration. */
+function LoadDHCPProxyNames()
+{
+    global $settings;
+    $path = $settings['mediaDirectory'] . '/config/dhcp-proxy-names.json';
+    if (!file_exists($path)) {
+        return [];
+    }
+    $data = json_decode(file_get_contents($path), true);
+    if (!is_array($data)) {
+        throw new RuntimeException('Unable to read saved DHCP custom names.');
+    }
+    return $data;
+}
+
+/**
+ * Merge changed labels by MAC address; an empty name removes a label.
+ * @route POST /api/proxies/dhcp-names
+ * @body [{"mac":"aa:bb:cc:dd:ee:ff","customName":"Mega Tree"}]
+ */
+function PostDHCPProxyNames()
+{
+    global $settings;
+    $changes = $_POST;
+    if (!is_array($changes) || !array_is_list($changes)) {
+        http_response_code(400);
+        return json(['error' => 'Expected an array of custom names.']);
+    }
+    foreach ($changes as $change) {
+        if (!is_array($change) || !isset($change['mac'], $change['customName']) ||
+            !is_string($change['mac']) || !is_string($change['customName']) ||
+            !preg_match('/^[0-9a-f]{2}(?::[0-9a-f]{2}){5}$/i', $change['mac']) ||
+            !preg_match('/^.{0,128}$/us', $change['customName']) ||
+            preg_match('/[\x00-\x1f\x7f]/', $change['customName'])) {
+            http_response_code(400);
+            return json(['error' => 'Each name needs a valid MAC address and at most 128 characters without control characters.']);
+        }
+    }
+    $path = $settings['mediaDirectory'] . '/config/dhcp-proxy-names.json';
+    $lock = fopen($path . '.lock', 'c');
+    if (!$lock || !flock($lock, LOCK_EX)) {
+        if ($lock) fclose($lock);
+        http_response_code(500);
+        return json(['error' => 'Unable to lock custom names for saving.']);
+    }
+    $temporary = false;
+    try {
+        $names = LoadDHCPProxyNames();
+        foreach ($changes as $change) {
+            $mac = strtolower($change['mac']);
+            $name = trim($change['customName']);
+            if ($name === '') {
+                unset($names[$mac]);
+            } else {
+                $names[$mac] = $name;
+            }
+        }
+        $encoded = json_encode((object)$names, JSON_PRETTY_PRINT | JSON_UNESCAPED_UNICODE | JSON_THROW_ON_ERROR) . "\n";
+        $temporary = tempnam(dirname($path), '.dhcp-names-');
+        if (!$temporary || file_put_contents($temporary, $encoded) !== strlen($encoded) ||
+            !chmod($temporary, 0664) || !rename($temporary, $path)) {
+            throw new RuntimeException('Unable to save DHCP custom names.');
+        }
+        return json(['status' => 'OK', 'names' => (object)$names]);
+    } catch (Throwable $error) {
+        http_response_code(500);
+        return json(['error' => $error->getMessage()]);
+    } finally {
+        if ($temporary && file_exists($temporary)) unlink($temporary);
+        flock($lock, LOCK_UN);
+        fclose($lock);
+    }
+}
